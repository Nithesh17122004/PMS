# ClinicFlow environment template.
# Copy to .env (development) or configure in the hosting provider dashboard.

# --- Runtime ---
APP_ENV=production
FLASK_ENV=production
PORT=5000
BASE_URL=http://localhost:5000

# --- Database (PostgreSQL in production) ---
DATABASE_URL=postgresql://pms_production_db_user:NzFKMmSjsINT3FQ60SOKV2TuMGZMeN8t@dpg-dbjebjgu01pc73f7naf0-a/pms_production_db

# --- Security ---
SECRET_KEY=Ya4VLIU-ix-53u88z_LuImcaZs-4RxYXrvLrlfSSY-E=
FIELD_ENCRYPTION_KEY=tPPSoXYG1RzN5jqDOg0EXyGN1ElfV6_FEu0emZZB7N8=
BLIND_INDEX_KEY=UpOr9dLwm3b8QkXZ5E-72TgdPkESjUgQHz8KyYbuoNk=
SESSION_COOKIE_SECURE=false
SESSION_HOURS=8
CSRF_ENABLED=true
MAX_CONTENT_LENGTH_MB=10
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RESET_TOKEN_MINUTES=30

# --- Rate limits ---
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=1000 per hour
RATELIMIT_LOGIN=10 per minute
RATELIMIT_PASSWORD_RESET=5 per minute

# --- Email / SMS / WhatsApp providers (leave empty to keep channels skipped) ---
MAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@clinicflow.app
MAIL_FROM_NAME=ClinicFlow
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# --- Background jobs ---
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=15
REMINDER_BATCH_SIZE=200

# --- Demo mode ---
DEMO_MODE=false
DEMO_NOTICE=Demonstration environment — all data is fictional.

# --- Uploads ---
UPLOAD_FOLDER=./instance/uploads
MAX_UPLOAD_MB=10
MAX_DOCUMENT_MB=10

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
